{
  "schema": "proofline-financial-role-policy/v1",
  "name": "canton-board-change-order-financial-roles-v1",
  "matter_policy_name": "canton-board-change-order-matters-v1",
  "rules": [
    {
      "name": "change-order-amount",
      "field_role": "change_amount",
      "amount_regex": "(?is)(?:net\\s+reduction\\s+in\\s+the\\s+amount\\s+of|(?:for\\s+a\\s+cost\\s+reduction\\s+)?in\\s+the\\s+amount\\s+of)\\s*(?P<amount>\\$\\s*\\d{1,3}(?:,\\d{3})*(?:\\.\\d{1,2})?)"
    },
    {
      "name": "resulting-contract-total",
      "field_role": "resulting_contract_total",
      "amount_regex": "(?is)(?:resulting\\s+in\\s+a\\s+new\\s+(?:contract|project)\\s+(?:amount|price)\\s+of|final\\s+contract\\s+price\\s+of)\\s*(?P<amount>\\$\\s*\\d{1,3}(?:,\\d{3})*(?:\\.\\d{1,2})?)"
    }
  ]
}
