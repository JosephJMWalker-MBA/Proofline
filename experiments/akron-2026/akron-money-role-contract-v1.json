{
  "schema": "proofline-akron-money-role-contract/v1",
  "contract_id": "akron-money-role-v1",
  "derived_from_receipt": "experiments/akron-2026/R1_T9_MONEY_CONTEXT_PROFILE.md",
  "parser_version": "proofline-structured/v2",
  "context_radius_chars": 320,
  "left_context_chars": 180,
  "default_role": "unclassified_money",
  "detector_authorized": false,
  "rules": [
    {
      "rule_id": "private_background_sales",
      "role": "private_background_amount",
      "context_all": ["sales volume", "sold over"],
      "left_regex": "sold\\s+over\\s*$"
    },
    {
      "rule_id": "city_expenditure_amount_field",
      "role": "city_expenditure_amount",
      "context_all": ["city expenditures"],
      "left_regex": "amount\\s*:\\s*$"
    },
    {
      "rule_id": "city_total_expenditure_field",
      "role": "city_expenditure_amount",
      "left_regex": "total expenditure(?: \\(if applicable\\))?\\s*:\\s*$"
    },
    {
      "rule_id": "contract_explicitly_funded",
      "role": "contract_amount",
      "context_all": ["contract with"],
      "context_any": ["funded from", "funded by", "funded out of", "owda loan"]
    },
    {
      "rule_id": "special_assessment_rate",
      "role": "assessment_rate",
      "context_all": ["resurfacing"],
      "left_regex": "(?:residential/charitable|other use)\\s*$"
    },
    {
      "rule_id": "conditional_use_fee_schedule_threshold",
      "role": "fee_schedule_threshold",
      "context_all": ["estimated total project cost", "applicable fee"],
      "numeric_in": ["0.00", "20000.00", "20001.00", "100000.00", "101001.00"]
    },
    {
      "rule_id": "conditional_use_filing_fee",
      "role": "filing_fee_amount",
      "context_all": ["estimated total project cost", "applicable fee"],
      "numeric_in": ["250.00", "750.00", "1500.00"]
    },
    {
      "rule_id": "estimated_project_cost_field",
      "role": "estimated_project_cost",
      "context_none": ["applicable fee"],
      "left_regex": "estimated\\s+total\\s+project\\s+cost\\s*:\\s*$"
    }
  ],
  "roles": [
    "fee_schedule_threshold",
    "filing_fee_amount",
    "estimated_project_cost",
    "city_expenditure_amount",
    "contract_amount",
    "assessment_rate",
    "private_background_amount",
    "unclassified_money"
  ],
  "non_claims": [
    "Role assignment does not establish a financial event.",
    "Repeated occurrences are not automatically independent transactions.",
    "Unclassified money is a valid outcome.",
    "This contract does not authorize anomaly, conflict, or suspiciousness labels."
  ]
}
